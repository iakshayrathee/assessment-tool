generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                       @id @default(cuid())
  email                       String                       @unique
  password                    String
  role                        UserRole
  isActive                    Boolean                      @default(true)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  lastLogin                   DateTime?
  adminProfile                AdminProfile?
  auditLogs                   AuditLog[]
  centerProfile               CenterProfile?
  parentProfile               ParentProfile?
  schoolViewerProfile         SchoolViewerProfile?
  specialEducatorProfile      SpecialEducatorProfile?
  superSpecialEducatorProfile SuperSpecialEducatorProfile?
  notifications               Notification[]
  requestedApprovals          ApprovalRequest[]            @relation("RequestedApprovals")
  targetUserApprovals         ApprovalRequest[]            @relation("TargetUserApprovals")
  approvedRequests            ApprovalRequest[]            @relation("ApprovedRequests")
  rejectedRequests            ApprovalRequest[]            @relation("RejectedRequests")
  passwordResetTokens         PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model SuperSpecialEducatorProfile {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  fullName                 String
  phone                    String?
  dateOfBirth              DateTime?
  gender                   Gender?
  address                  String?
  primaryLanguage          String?
  secondaryLanguages       String[]
  highestQualification     String?
  fieldOfStudy             String?
  institutionName          String?
  yearOfGraduation         Int?
  rciCertified             Boolean            @default(false)
  rciValidityDate          DateTime?
  specialEdQualification   String?
  specializationAreas      String[]
  yearsOfExperience        Int?
  experienceTypes          String[]
  maxGroupSize             Int?
  currentWorkLocations     String[]
  ldTypesHandled           String[]
  gradeLevelsServed        String[]
  assessmentTools          String?
  assistiveTechProficiency String[]
  areasOfInterest          String[]
  consentToShare           Boolean            @default(false)
  agreementToPolicies      Boolean            @default(false)
  personalStatement        String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  assignedCenters          CenterAssignment[]
  assignedSchools          SchoolAssignment[]
  reviewedReports          Report[]
  trainingLogs             TrainingLog[]
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("super_special_educator_profiles")
}

model SpecialEducatorProfile {
  id                       String                   @id @default(cuid())
  userId                   String                   @unique
  fullName                 String
  phone                    String?
  dateOfBirth              DateTime?
  gender                   Gender?
  address                  String?
  primaryLanguage          String?
  secondaryLanguages       String[]
  highestQualification     String?
  fieldOfStudy             String?
  institutionName          String?
  yearOfGraduation         Int?
  rciCertified             Boolean                  @default(false)
  rciValidityDate          DateTime?
  specialEdQualification   String?
  specializationAreas      String[]
  yearsOfExperience        Int?
  experienceTypes          String[]
  maxGroupSize             Int?
  currentWorkLocations     String[]
  ldTypesHandled           String[]
  gradeLevelsServed        String[]
  assessmentTools          String?
  assistiveTechProficiency String[]
  areasOfInterest          String[]
  consentToShare           Boolean                  @default(false)
  agreementToPolicies      Boolean                  @default(false)
  personalStatement        String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  additionalCertifications String[]
  totalYearsOfExperience   Int?
  assessments              Assessment[]
  formalAssessments        FormalAssessment[]
  readingSkillAssessments  ReadingSkillAssessment[]
  writingSkillAssessments  WritingSkillAssessment[]
  mathSkillAssessments     MathSkillAssessment[]
  longTermPlans            LongTermPlan[]
  shortTermPlans           ShortTermPlan[]
  weeklyLessonPlans        WeeklyLessonPlan[]
  homework                 Homework[]
  centerAssignments        CenterAssignment[]
  schoolAssignments        SchoolAssignment[]
  iepGoals                 IEPGoal[]
  intakeForms              IntakeForm[]
  reports                  Report[]
  sessionNotes             SessionNote[]
  trainingLogs             TrainingLog[]
  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedStudents         StudentAssignment[]
  ieps                     IEP[]
  iepDocuments             IEPDocument[]

  @@map("special_educator_profiles")
}

model CenterProfile {
  id              String                 @id @default(cuid())
  userId          String                 @unique
  centerName      String
  address         String?
  phone           String?
  email           String?
  contactPerson   String?
  operatingHours  String?
  description     String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  assignments     CenterAssignment[]
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  schools         School[]
  students        Student[]
  reportSnapshots CenterReportSnapshot[]

  @@map("center_profiles")
}

model ParentProfile {
  id               String                 @id @default(cuid())
  userId           String                 @unique
  fullName         String
  phone            String?
  address          String?
  emergencyContact String?
  relationship     String                 @default("Parent")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  concerns         ParentConcern[]
  documents        ParentDocument[]
  homework         Homework[]
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  children         Student[]
  reportSnapshots  ParentReportSnapshot[]

  @@map("parent_profiles")
}

model SchoolViewerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  position  String?
  phone     String?
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("school_viewer_profiles")
}

model School {
  id              String                 @id @default(cuid())
  name            String
  address         String?
  phone           String?
  email           String?
  principalName   String?
  centerId        String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  viewers         SchoolViewerProfile[]
  center          CenterProfile?         @relation(fields: [centerId], references: [id])
  students        Student[]
  assignments     SchoolAssignment[]
  reportSnapshots SchoolReportSnapshot[]

  @@map("schools")
}

model Student {
  id                      String                   @id @default(cuid())
  fullName                String
  dateOfBirth             DateTime
  age                     Int
  gender                  Gender
  grade                   String
  motherTongue            String?
  syllabus                String?
  status                  StudentStatus            @default(ACTIVE)
  registrationDate        DateTime                 @default(now())
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  centerId                String
  schoolId                String?
  parentId                String?
  riskCategory            RiskCategory?            @default(ON_TRACK)
  lastRiskAssessment      DateTime?
  assessments             Assessment[]
  formalAssessments       FormalAssessment[]
  readingSkillAssessments ReadingSkillAssessment[]
  writingSkillAssessments WritingSkillAssessment[]
  mathSkillAssessments    MathSkillAssessment[]
  longTermPlans           LongTermPlan[]
  shortTermPlans          ShortTermPlan[]
  weeklyLessonPlans       WeeklyLessonPlan[]
  homework                Homework[]
  iepGoals                IEPGoal[]
  intakeForms             IntakeForm[]
  reports                 Report[]
  sessionNotes            SessionNote[]
  assignments             StudentAssignment[]
  documents               StudentDocument[]
  center                  CenterProfile            @relation(fields: [centerId], references: [id])
  parent                  ParentProfile?           @relation(fields: [parentId], references: [id])
  school                  School?                  @relation(fields: [schoolId], references: [id])
  ieps                    IEP[]
  iepDocuments            IEPDocument[]
  reportSnapshots         ParentReportSnapshot[]

  @@map("students")
}

model StudentAssignment {
  id                String                 @id @default(cuid())
  studentId         String
  specialEducatorId String
  assignedDate      DateTime               @default(now())
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  specialEducator   SpecialEducatorProfile @relation(fields: [specialEducatorId], references: [id])
  student           Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, specialEducatorId])
  @@map("student_assignments")
}

model IEP {
  id                 String    @id @default(cuid())
  studentId          String
  educatorId         String
  startDate          DateTime
  endDate            DateTime
  presentLevel       Json?
  longTermGoals      Json[]
  shortTermGoals     Json[]
  areasOfRemediation String[]
  status             IEPStatus @default(DRAFT)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  student     Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  educator    SpecialEducatorProfile @relation(fields: [educatorId], references: [id])
  weeklyPlans WeeklyPlan[]

  @@map("ieps")
}

model WeeklyPlan {
  id            String   @id @default(cuid())
  iepId         String
  weekStartDate DateTime
  weekEndDate   DateTime
  monthlyPlan   Json[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  iep         IEP                @relation(fields: [iepId], references: [id], onDelete: Cascade)
  evaluations WeeklyEvaluation[]

  @@map("weekly_plans")
}

model WeeklyEvaluation {
  id                String   @id @default(cuid())
  weeklyPlanId      String
  evaluationDate    DateTime
  oralLanguage      Json?
  reading           Json?
  writing           Json?
  spelling          Json?
  math              Json?
  attention         String?
  behavioralSitting String?
  taskCompletion    String?
  strategies        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  weeklyPlan WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)

  @@map("weekly_evaluations")
}

enum IEPStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

model CenterAssignment {
  id                     String                       @id @default(cuid())
  centerId               String
  specialEducatorId      String?
  superSpecialEducatorId String?
  assignedDate           DateTime                     @default(now())
  isActive               Boolean                      @default(true)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  center                 CenterProfile                @relation(fields: [centerId], references: [id])
  specialEducator        SpecialEducatorProfile?      @relation(fields: [specialEducatorId], references: [id])
  superSpecialEducator   SuperSpecialEducatorProfile? @relation(fields: [superSpecialEducatorId], references: [id])

  @@map("center_assignments")
}

model SchoolAssignment {
  id                     String                       @id @default(cuid())
  schoolId               String
  specialEducatorId      String?
  superSpecialEducatorId String?
  assignedDate           DateTime                     @default(now())
  isActive               Boolean                      @default(true)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  school                 School                       @relation(fields: [schoolId], references: [id])
  specialEducator        SpecialEducatorProfile?      @relation(fields: [specialEducatorId], references: [id])
  superSpecialEducator   SuperSpecialEducatorProfile? @relation(fields: [superSpecialEducatorId], references: [id])

  @@map("school_assignments")
}

model IntakeForm {
  id                                String                 @id @default(cuid())
  studentId                         String
  specialEducatorId                 String
  address                           String?
  familyIncome                      String?
  familyType                        String?
  digitalResourcesAtHome            Boolean?
  dailyDigitalUse                   Int?
  enjoysSchool                      Boolean?
  studyAssistant                    String?
  externalAcademicSupport           Boolean?
  enjoysReading                     Boolean?
  dailyParentChildTime              Int?
  childType                         String?
  fatherName                        String?
  motherName                        String?
  guardianName                      String?
  pregnancyNormal                   Boolean?
  medicationsDuringPregnancy        String?
  miscarriagesAbortions             Boolean?
  fullTermOrPremature               String?
  deliveryType                      String?
  gestationalAge                    String?
  nicuStay                          String?
  birthWeight                       String?
  pregnancyComplications            String[]
  feedingDifficulties               Boolean?
  significantIllness                Boolean?
  significantIllnessDetails         String?
  breastFed                         String?
  breastFedDuration                 Int?
  infantJaundice                    Boolean?
  infantJaundiceTreatment           String?
  incubation                        Boolean?
  incubationDays                    Int?
  incubationReason                  String[]
  immunizationDone                  String?
  consanguineousMarriage            String?
  birthCry                          String?
  birthCryDelayDuration             String?
  resuscitationRequired             Boolean?
  delayInNeckStanding               Boolean?
  delayInNeckStandingDetails        String?
  seizuresInfancy                   Boolean?
  seizuresInfancyDetails            String?
  visionProblemsEarly               Boolean?
  hearingProblemsEarly              Boolean?
  hospitalizationFirstTwoYears      Boolean?
  hospitalizationFirstTwoYearsReason String?
  ageOfWalking                      Int?
  ageOfTwoWordSpeech                Int?
  healthConcerns                    String?
  epilepticHistory                  Boolean?
  epilepsyType                      String?
  epilepsyLastEpisode               String?
  epilepsyFrequency                 String?
  epilepsyUnderMedicalCare          Boolean?
  onMedication                      Boolean?
  medicationDetails                 String?
  medicationName                    String?
  medicationDosage                  String?
  medicationFrequency               String?
  medicationPurpose                 String[]
  asthmaWheezing                    Boolean?
  asthmaUsesInhaler                 Boolean?
  asthmaFrequency                   String?
  asthmaEmergencyPlan               Boolean?
  wearsGlasses                      Boolean?
  glassesUsage                      String?
  visionTestDone                    Boolean?
  visionTestResult                  String?
  visionTestDate                    String?
  hearingTestDone                   Boolean?
  hearingTestResult                 String?
  hearingTestDate                   String?
  sleepDifficulties                 Boolean?
  sleepDifficultiesDetails          String[]
  hospitalizationHistory            Boolean?
  hospitalizationHistoryReason      String?
  hospitalizationHistoryDate        String?
  attendedPreschool                 Boolean?
  repeatedGrades                    Boolean?
  whichGradeRepeated                String?
  dominantWritingHand               String?
  strugglesInLanguages              Boolean?
  ageStartedPreschool               Int?
  yearsPreschool                    Int?
  reasonForRepeating                String?
  overallPerformance                String?
  overallPercentage                 Int?
  subjectPerformance                Json?
  subjectMarks                      Json?
  academicTrend                     String?
  teacherComments                   String?
  languageStruggles                 String[]
  mathStruggles                     String[]
  homeworkCompletion                String?
  classroomParticipation            String?
  attendancePercentage              Int?
  learningStrengths                 String[]
  areasSupport                      String[]
  previousSupport                   String[]

  // ── BLOCK A: REFERRAL (separate screen before intake form) ──────────────
  referralSource                    String[]  // ["PARENT","TEACHER","SCHOOL","PEDIATRICIAN","PSYCHOLOGIST","SPECIAL_EDUCATOR"]
  referralAreas                     String[]  // ["READING","WRITING","MATH","ATTENTION","BEHAVIOUR","SPEECH","SCHOOL_READINESS"]
  durationOfConcern                 String?   // "LESS_THAN_6_MONTHS"|"6_TO_12_MONTHS"|"1_TO_2_YEARS"|"MORE_THAN_2_YEARS"
  severityOfConcern                 String?   // "MILD"|"MODERATE"|"SEVERE"

  // ── BLOCK B: EXTENDED DEMOGRAPHICS ─────────────────────────────────
  mediumOfInstruction               String?   // "English"|"Kannada"|"Hindi"|"Tamil"|"Other"
  yearsExposedToInstruction         Int?
  schoolType                        String?   // "MAINSTREAM"|"INCLUSIVE"|"SPECIAL"|"ALTERNATIVE"
  numberOfLanguagesUnderstood       Int?
  schoolAttendance                  String?   // "EXCELLENT"|"GOOD"|"AVERAGE"|"POOR"
  // New fields added with demographics expansion
  city                              String?   // City portion of address
  state                             String?   // State/province
  urbanOrRural                      String?   // "Urban"|"Semi-Urban"|"Rural"
  chronologicalAge                  String?   // Display string: "11 years 3 months"
  languageSpokenAtHome              String?   // Single-select primary home language
  previousGradeRetention            String?   // "Yes"|"No"

  // ── BLOCK C: EXTENDED FAMILY HISTORY ──────────────────────────────
  primaryCaregiver                  String?   // "MOTHER"|"FATHER"|"GRANDPARENT"|"GUARDIAN"|"SHARED"
  childLivesWith                    String[]  // ["BOTH_PARENTS","MOTHER","FATHER","GRANDPARENTS","GUARDIAN","OTHER"]
  numberOfSiblings                  Int?
  birthOrder                        String?   // "FIRST"|"MIDDLE"|"YOUNGEST"|"ONLY"
  familyHistoryOfDifficulties       Boolean?
  familyHistoryDetails              String?   // freetext: who and what difficulty
  digitalResourceTypes              String[]  // ["SMARTPHONE","TABLET","LAPTOP","DESKTOP","INTERNET","EDUCATIONAL_APPS","NONE"]
  languagesSpokenAtHome             String[]  // ["KANNADA","ENGLISH","HINDI","TAMIL","TELUGU","OTHER"]
  parentHelpsWithHomework           String?   // "ALWAYS"|"OFTEN"|"SOMETIMES"|"RARELY"|"NEVER"
  enjoySchoolRating                 Int?      // 1–5 scale (supplements enjoysSchool boolean)
  enjoyReadingRating                Int?      // 1–5 scale (supplements enjoysReading boolean)
  externalSupportTypes              String[]  // ["TUITION","SPECIAL_EDUCATION","NONE"]

  // ── BLOCK D: AI INTAKE PROFILE (updated progressively after each tab) ────
  intakeAIProfile                   Json?     // Cumulative 7-section profile JSON
  intakeAIGeneratedAt               DateTime? // Timestamp of last generation
  intakeAIConfidence                String?   // "LOW"|"LOW_MEDIUM"|"MEDIUM"|"MEDIUM_HIGH"|"HIGH"

  status                            AssessmentStatus       @default(PENDING)
  completedAt                       DateTime?
  createdAt                         DateTime               @default(now())
  updatedAt                         DateTime               @updatedAt
  medicationsDuringPregnancyDetails String?
  specialEducator                   SpecialEducatorProfile @relation(fields: [specialEducatorId], references: [id])
  student                           Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("intake_forms")
}

// Informal Assessment (existing structure - now explicitly informal)
model Assessment {
  id                    String                 @id @default(cuid())
  studentId             String
  specialEducatorId     String
  readingObservations   String?
  readingLevel          String?
  readingFiles          String[]
  writingObservations   String?
  writingLevel          String?
  writingFiles          String[]
  mathObservations      String?
  mathLevel             String?
  mathFiles             String[]
  vpObservations        String?
  vpLevel               String?
  vpFiles               String[]
  motorObservations     String?
  motorLevel            String?
  motorFiles            String[]
  attentionObservations String?
  attentionLevel        String?
  attentionFiles        String[]
  assessmentType        String                 @default("Initial")
  status                AssessmentStatus       @default(PENDING)
  completedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  specialEducator       SpecialEducatorProfile @relation(fields: [specialEducatorId], references: [id])
  student               Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("assessments")
}

// Formal Assessment
model FormalAssessment {
  id                String                 @id @default(cuid())
  studentId         String
  specialEducatorId String
  assessmentType    String? // Type of formal assessment (optional in simplified form)
  referralReason    String?
  referralDate      DateTime?              // Optional — not captured in simplified form
  referredBy        String? // Auto-filled from educator
  conductedBy       String?
  credentials       String?
  clinicName        String?
  assessmentDate    DateTime?
  keyFindings       String?
  diagnosis         String?
  recommendations   String?
  summary           String?               // Free-text summary of key findings (new simplified form)
  uploadedFiles     String[]              // Array of file paths/URLs (PDF/DOCX)
  status            AssessmentStatus       @default(PENDING)
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  specialEducator   SpecialEducatorProfile @relation(fields: [specialEducatorId], references: [id])
  student           Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("formal_assessments")
}

// Reading Skill Assessment (Redesigned — 14-section structured assessment)
model ReadingSkillAssessment {
  id                String @id @default(cuid())
  studentId         String
  specialEducatorId String

  // ── SECTION 1: BASIC INFO ──────────────────────────────────────────────────
  assessmentDate          DateTime? // Date of assessment
  mediumOfInstruction     String?   // English / Hindi / Regional
  firstLanguage           String?   // Dropdown
  parentConcern           String?   // Textarea

  // ── SECTION 2: READING CONTEXT ─────────────────────────────────────────────
  readingExposureAtHome   String?   // Daily / Few times a week / Occasionally / Rarely / Never
  readingSupportAtHome    String?   // Regular support (daily/weekly) / Occasional support / No support
  readingSupportDetails   String?
  exposureDetails         String?   // Details about reading exposure
  supportDetails          String?   // Details about reading support
  typeOfSchooling         String?   // CBSE / ICSE / State / IB / Other
  languageMismatch        String?   // No / Yes - minor difference / Yes - major difference
  previousIntervention    String?   // None / School-based support / Private tutoring / Therapy / Not sure
  previousInterventionType String?
  interventionDetails     String?   // Details about intervention
  readingMaterialAccess   String?   // Books available / Digital content / Very limited access / No access

  // Enhanced Scoring Fields for Learning Context
  exposureScore           Int?      // 0-3 (Daily=3, Few times/week=2, Occasionally=1, Rare/Never=0)
  supportScore            Int?      // 0-2 (Regular=2, Occasional=1, None=0)
  interventionScore       Int?      // 0-2 (Therapy=2, Tutoring=1, None=0)
  languageRiskScore       Int?      // 0-2 (Major=2, Minor=1, None=0)
  materialAccessScore     Int?      // 0-2 (Books=2, Digital=1, None=0)
  environmentScore        Int?      // 0-7 (Exposure + Support + Material Access)
  environmentBuffer       Int?      // 0, 5, or 15 based on ES

  // ── SECTION 3: READING RESOURCES (JSON) ────────────────────────────────────
  // { schoolText: { gradeLevelUsed, difficulty }, knownText: { passageId, accuracyPercent, errorsCount },
  //   unknownText: { passageId, accuracyPercent, errorsCount }, externalResources: { usesStorybooks, usesApps, materialType } }
  readingResources Json?

  // ── SECTION 4: READING BEHAVIOR (1-5 rating scales) ────────────────────────
  interestInReading       Int? // 1-5
  attentionSpanMinutes    Int? // minutes
  readingStamina          Int? // 1-5
  frustrationTolerance    Int? // 1-5
  emotionalResponse       String? // Calm / Avoidant / Anxious
  taskAvoidance           Boolean?
  motivation              String? // Intrinsic / Prompted / Resistant
  confidenceLevel         Int? // 1-5
  selfCorrectionAbility   String? // Independent / Prompted / None
  promptDependency        String? // Independent / Needs cues / Fully assisted
  behaviorObservations    String? // Textarea

  // ── SECTION 5: CORE READING SKILLS (JSON sub-sections) ─────────────────────
  // A. Phonological Awareness: { rhyming, blending, segmenting, soundIdentification }
  phonologicalAwareness Json?
  // B. Decoding: { letterSoundKnowledge, cvcWords, blendsDigraphs, multisyllabicDecoding }
  decodingSkills Json?
  // C. Fluency
  wordsPerMinute    Int?   // WPM
  fluencyAccuracy   Float? // % accuracy
  fluencyErrorRate  Float? // errors per 100 words
  hesitationCount   Int?   // count
  // D. Sight Words
  sightWordsPercent Float? // % correct from grade list
  // E. Mechanics
  punctuationAwareness Boolean?
  readingExpression    String? // Flat / Moderate / Good
  pausingCorrectness   String? // Correct / Incorrect
  // F. Visual Tracking
  skipsLinesVisual     Boolean?  // Visual tracking: skips lines
  usesFinger           Boolean?
  losesPlace           Boolean?

  // ── SECTION 6: COMPREHENSION (JSON) ────────────────────────────────────────
  // { literal: { recallFacts, identifyCharacters }, inferential: { prediction, meaningInference },
  //   critical: { opinionFormation, realLifeConnection }, retelling: { sequencing, completeness } }
  comprehension Json?

  // ── SECTION 7: ERROR ANALYSIS (JSON) ───────────────────────────────────────
  // { substitution, omission, insertion, reversal, guessing, slowDecoding, repetition,
  //   skippingLines } — each: { present: bool, frequency: number }
  // + errorFrequencyPercent, dominantErrorType (auto-tagged)
  errorAnalysis Json?

  // ── SECTION 8: STRENGTHS ───────────────────────────────────────────────────
  // { selected: ["strongPhonics","goodMemory",...], educatorNotes: "..." }
  strengths Json?

  // ── SECTION 9: CHALLENGES ──────────────────────────────────────────────────
  primaryChallenge   String?
  secondaryChallenge String?
  challengeSeverity  String? // Mild / Moderate / Severe

  // ── SECTION 10: RED FLAGS ──────────────────────────────────────────────────
  // { attentionIssues, languageProcessingIssues, avoidanceBehavior, custom: [] }
  redFlags Json?

  // ── SECTION 11: LEVEL CLASSIFICATION (auto-computed) ───────────────────────
  knownTextAccuracy   Float? // % accuracy for known text
  unknownTextAccuracy Float? // % accuracy for unknown text
  knownTextLevel      String? // Independent / Instructional / Frustration
  unknownTextLevel    String? // Independent / Instructional / Frustration
  finalReadingLevel   String? // Auto: Independent / Instructional / Frustration

  // ── SECTION 12: GRADE LEVEL MAPPING ────────────────────────────────────────
  currentGrade        String?
  readingGradeLevel   String? // AI predicted
  gradeGap            String? // e.g., "-2 years"

  // ── SECTION 13: AI INSIGHTS & PLAN (JSON, editable) ────────────────────────
  // { diagnosisSummary, recommendations, instructionalStrategies, interventions: { programType, frequency },
  //   supportPlan: { classroom, home }, learningPath: { fourWeekGoals, threeMonthGoals } }
  aiInsights       Json?
  aiInsightsStatus String? // AI_DRAFT / EDUCATOR_REVIEWED / FINAL

  // ── SECTION 14: PROGRESS TRACKING (JSON) ───────────────────────────────────
  // { baselineScore, currentScore, improvementPercent, sessionsCompleted, reassessmentDate, graphData }
  progressTracking Json?

  // ── COMPUTED SCORES (backend-calculated) ───────────────────────────────────
  decodingScore        Float? // 0-100
  fluencyScore         Float? // 0-100
  comprehensionScore   Float? // 0-100
  behaviorScore        Float? // 0-100
  overallReadingScore  Float? // 0-100 weighted composite
  
  // Enhanced Scoring System - Resources Section
  schoolTextScore      Float? // Section A score calculation
  knownTextScore       Float? // Section B score calculation  
  unknownTextScore     Float? // Section C score calculation
  finalReadingScore    Float? // RS = (School × 0.2) + (Known × 0.3) + (Unknown × 0.5)
  
  // Enhanced Scoring System - Final Risk Assessment
  resourceContextScore Int?      // Resource usage + Level alignment + Independence
  finalRiskScore       Int?      // FRS = (100 - RS) - Buffer - LR - IF
  
  tier                 String? // Tier 1 / Tier 2 / Tier 3 (based on FRS)
  ldRiskFlag           Boolean @default(false)
  ldRiskDetails        String? // e.g., "Dyslexia pattern detected"
  
  // Detailed Resource Assessment Fields
  schoolTextGradeLevel String?   // Grade level used for school text
  schoolTextDifficulty String?   // Easy / Grade Level / Hard
  schoolTextQuality    String?   // Excellent / Good / Developing / Needs Support
  schoolTextFluency    String?   // Fast / On-level / Slow / Very slow
