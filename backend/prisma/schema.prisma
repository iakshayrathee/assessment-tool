generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                       @id @default(cuid())
  email                       String                       @unique
  password                    String
  role                        UserRole
  isActive                    Boolean                      @default(true)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  lastLogin                   DateTime?
  adminProfile                AdminProfile?
  approvedRequests            ApprovalRequest[]            @relation("ApprovedRequests")
  rejectedRequests            ApprovalRequest[]            @relation("RejectedRequests")
  requestedApprovals          ApprovalRequest[]            @relation("RequestedApprovals")
  targetUserApprovals         ApprovalRequest[]            @relation("TargetUserApprovals")
  auditLogs                   AuditLog[]
  centerProfile               CenterProfile?
  notifications               Notification[]
  parentProfile               ParentProfile?
  schoolViewerProfile         SchoolViewerProfile?
  specialEducatorProfile      SpecialEducatorProfile?
  superSpecialEducatorProfile SuperSpecialEducatorProfile?

  @@map("users")
}

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model SuperSpecialEducatorProfile {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  fullName                 String
  phone                    String?
  dateOfBirth              DateTime?
  gender                   Gender?
  address                  String?
  primaryLanguage          String?
  secondaryLanguages       String[]
  highestQualification     String?
  fieldOfStudy             String?
  institutionName          String?
  yearOfGraduation         Int?
  rciCertified             Boolean            @default(false)
  rciValidityDate          DateTime?
  specialEdQualification   String?
  specializationAreas      String[]
  yearsOfExperience        Int?
  experienceTypes          String[]
  maxGroupSize             Int?
  currentWorkLocations     String[]
  ldTypesHandled           String[]
  gradeLevelsServed        String[]
  assessmentTools          String?
  assistiveTechProficiency String[]
  areasOfInterest          String[]
  consentToShare           Boolean            @default(false)
  agreementToPolicies      Boolean            @default(false)
  personalStatement        String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  assignedCenters          CenterAssignment[]
  reviewedReports          Report[]
  assignedSchools          SchoolAssignment[]
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingLogs             TrainingLog[]

  @@map("super_special_educator_profiles")
}

model SpecialEducatorProfile {
  id                       String                   @id @default(cuid())
  userId                   String                   @unique
  fullName                 String
  phone                    String?
  dateOfBirth              DateTime?
  gender                   Gender?
  address                  String?
  primaryLanguage          String?
  secondaryLanguages       String[]
  highestQualification     String?
  fieldOfStudy             String?
  institutionName          String?
  yearOfGraduation         Int?
  rciCertified             Boolean                  @default(false)
  rciValidityDate          DateTime?
  specialEdQualification   String?
  specializationAreas      String[]
  yearsOfExperience        Int?
  experienceTypes          String[]
  maxGroupSize             Int?
  currentWorkLocations     String[]
  ldTypesHandled           String[]
  gradeLevelsServed        String[]
  assessmentTools          String?
  assistiveTechProficiency String[]
  areasOfInterest          String[]
  consentToShare           Boolean                  @default(false)
  agreementToPolicies      Boolean                  @default(false)
  personalStatement        String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  additionalCertifications String[]
  totalYearsOfExperience   Int?
  assessments              Assessment[]
  centerAssignments        CenterAssignment[]
  formalAssessments        FormalAssessment[]
  homework                 Homework[]
  iepDocuments             IEPDocument[]
  iepGoals                 IEPGoal[]
  ieps                     IEP[]
  intakeForms              IntakeForm[]
  longTermPlans            LongTermPlan[]
  massAssessments          MassAssessment[]
  mathSkillAssessments     MathSkillAssessment[]
  readingSkillAssessments  ReadingSkillAssessment[]
  reports                  Report[]
  schoolAssignments        SchoolAssignment[]
  sessionNotes             SessionNote[]
  shortTermPlans           ShortTermPlan[]
  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedStudents         StudentAssignment[]
  trainingLogs             TrainingLog[]
  weeklyLessonPlans        WeeklyLessonPlan[]
  worksheet_templates      worksheet_templates[]
  writingSkillAssessments  WritingSkillAssessment[]

  @@map("special_educator_profiles")
}

model CenterProfile {
  id              String                 @id @default(cuid())
  userId          String                 @unique
  centerName      String
  address         String?
  phone           String?
  email           String?
  contactPerson   String?
  operatingHours  String?
  description     String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  assignments     CenterAssignment[]
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportSnapshots CenterReportSnapshot[]
  massAssessments MassAssessment[]
  schools         School[]
  students        Student[]

  @@map("center_profiles")
}

model ParentProfile {
  id               String                 @id @default(cuid())
  userId           String                 @unique
  fullName         String
  phone            String?
  address          String?
  emergencyContact String?
  relationship     String                 @default("Parent")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  homework         Homework[]
  concerns         ParentConcern[]
  documents        ParentDocument[]
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportSnapshots  ParentReportSnapshot[]
  children         Student[]

  @@map("parent_profiles")
}

model SchoolViewerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  position  String?
  phone     String?
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("school_viewer_profiles")
}

model School {
  id              String                 @id @default(cuid())
  name            String
  address         String?
  phone           String?
  email           String?
  principalName   String?
  centerId        String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  massAssessments MassAssessment[]
  assignments     SchoolAssignment[]
  reportSnapshots SchoolReportSnapshot[]
  viewers         SchoolViewerProfile[]
  center          CenterProfile?         @relation(fields: [centerId], references: [id])
  students        Student[]

  @@map("schools")
}

model Student {
  id                           String                         @id @default(cuid())
  fullName                     String
  dateOfBirth                  DateTime
  age                          Int
  gender                       Gender
  grade                        String
  motherTongue                 String?
  syllabus                     String?
  status                       StudentStatus                  @default(ACTIVE)
  registrationDate             DateTime                       @default(now())
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  centerId                     String
  schoolId                     String?
  parentId                     String?
  lastRiskAssessment           DateTime?
  riskCategory                 RiskCategory?                  @default(ON_TRACK)
  assessments                  Assessment[]
  formalAssessments            FormalAssessment[]
  homework                     Homework[]
  iepDocuments                 IEPDocument[]
  iepGoals                     IEPGoal[]
  ieps                         IEP[]
  intakeForms                  IntakeForm[]
  intervention_recommendations intervention_recommendations[]
  longTermPlans                LongTermPlan[]
  massAssessmentResults        MassAssessmentResult[]
  mathSkillAssessments         MathSkillAssessment[]
  reportSnapshots              ParentReportSnapshot[]
  readingSkillAssessments      ReadingSkillAssessment[]
  reports                      Report[]
  sessionNotes                 SessionNote[]
  shortTermPlans               ShortTermPlan[]
  assignments                  StudentAssignment[]
  documents                    StudentDocument[]
  center                       CenterProfile                  @relation(fields: [centerId], references: [id])
  parent                       ParentProfile?                 @relation(fields: [parentId], references: [id])
  school                       School?                        @relation(fields: [schoolId], references: [id])
  weeklyLessonPlans            WeeklyLessonPlan[]
  writingSkillAssessments      WritingSkillAssessment[]

  @@map("students")
}

model StudentAssignment {
  id                String                 @id @default(cuid())
  studentId         String
  specialEducatorId String
  assignedDate      DateTime               @default(now())
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  specialEducator   SpecialEducatorProfile @relation(fields: [specialEducatorId], references: [id])
  student           Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, specialEducatorId])
  @@map("student_assignments")
}

model IEP {
  id                 String                 @id @default(cuid())
  studentId          String
  educatorId         String
  startDate          DateTime
  endDate            DateTime
  status             IEPStatus              @default(DRAFT)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  longTermGoals      Json[]
  presentLevel       Json?
  shortTermGoals     Json[]
  areasOfRemediation String[]
  educator           SpecialEducatorProfile @relation(fields: [educatorId], references: [id])
  student            Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weeklyPlans        WeeklyPlan[]

  @@map("ieps")
}

model WeeklyPlan {
  id            String             @id @default(cuid())
  iepId         String
  weekStartDate DateTime
  weekEndDate   DateTime
  monthlyPlan   Json[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  evaluations   WeeklyEvaluation[]
  iep           IEP                @relation(fields: [iepId], references: [id], onDelete: Cascade)

  @@map("weekly_plans")
}

model WeeklyEvaluation {
  id                String     @id @default(cuid())
  evaluationDate    DateTime
  oralLanguage      Json?
  reading           Json?
  writing           Json?
  spelling          Json?
  math              Json?
  attention         String?
  behavioralSitting String?
  taskCompletion    String?
  strategies        String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  weeklyPlanId      String
  weeklyPlan        WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)

  @@map("weekly_evaluations")
}

model CenterAssignment {
  id                     String                       @id @default(cuid())
  centerId               String
  specialEducatorId      String?
  superSpecialEducatorId String?
  assignedDate           DateTime                     @default(now())
  isActive               Boolean                      @default(true)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  center                 CenterProfile                @relation(fields: [centerId], references: [id])
  specialEducator        SpecialEducatorProfile?      @relation(fields: [specialEducatorId], references: [id])
  superSpecialEducator   SuperSpecialEducatorProfile? @relation(fields: [superSpecialEducatorId], references: [id])

  @@map("center_assignments")
}

model SchoolAssignment {
  id                     String                       @id @default(cuid())
  schoolId               String
  specialEducatorId      String?
  superSpecialEducatorId String?
  assignedDate           DateTime                     @default(now())
  isActive               Boolean                      @default(true)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  school                 School                       @relation(fields: [schoolId], references: [id])
  specialEducator        SpecialEducatorProfile?      @relation(fields: [specialEducatorId], references: [id])
  superSpecialEducator   SuperSpecialEducatorProfile? @relation(fields: [superSpecialEducatorId], references: [id])

  @@map("school_assignments")
}

model IntakeForm {
  id                                String                 @id @default(cuid())
  studentId                         String
  specialEducatorId                 String
  address                           String?
  familyIncome                      String?
  familyType                        String?
  digitalResourcesAtHome            Boolean?
  dailyDigitalUse                   Int?
  enjoysSchool                      Boolean?
  studyAssistant                    String?
  externalAcademicSupport           Boolean?
  enjoysReading                     Boolean?
  dailyParentChildTime              Int?
  childType                         String?
  fatherName                        String?
  motherName                        String?
  guardianName                      String?
  pregnancyNormal                   Boolean?
  medicationsDuringPregnancy        String?
  miscarriagesAbortions             Boolean?
  fullTermOrPremature               String?
  deliveryType                      String?
  breastFed                         Boolean?
  infantJaundice                    Boolean?
  incubation                        Boolean?
  immunizationDone                  Boolean?
  consanguineousMarriage            Boolean?
  birthCry                          String?
  delayInNeckStanding               Boolean?
  delayInNeckStandingDetails        String?
  ageOfWalking                      Int?
  ageOfTwoWordSpeech                Int?
  healthConcerns                    String?
  epilepticHistory                  Boolean?
  onMedication                      Boolean?
  medicationDetails                 String?
  asthmaWheezing                    Boolean?
  wearsGlasses                      Boolean?
  visionTestDone                    Boolean?
  hearingTestDone                   Boolean?
  attendedPreschool                 Boolean?
  repeatedGrades                    Boolean?
  whichGradeRepeated                String?
  dominantWritingHand               String?
  strugglesInLanguages              Boolean?
  status                            AssessmentStatus       @default(PENDING)
  completedAt                       DateTime?
  createdAt                         DateTime               @default(now())
  updatedAt                         DateTime               @updatedAt
  medicationsDuringPregnancyDetails String?
  specialEducator                   SpecialEducatorProfile @relation(fields: [specialEducatorId], references: [id])
  student                           Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("intake_forms")
}

model Assessment {
  id                    String                 @id @default(cuid())
  studentId             String
  specialEducatorId     String
  readingObservations   String?
  readingLevel          String?
  readingFiles          String[]
  writingObservations   String?
  writingLevel          String?
  writingFiles          String[]
  mathObservations      String?
  mathLevel             String?
  mathFiles             String[]
  vpObservations        String?
  vpLevel               String?
  vpFiles               String[]
  motorObservations     String?
  motorLevel            String?
  motorFiles            String[]
  attentionObservations String?
  attentionLevel        String?
  attentionFiles        String[]
  assessmentType        String                 @default("Initial")
  status                AssessmentStatus       @default(PENDING)
  completedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  specialEducator       SpecialEducatorProfile @relation(fields: [specialEducatorId], references: [id])
  student               Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("assessments")
}

model FormalAssessment {
  id                String                 @id @default(cuid())
  studentId         String
  specialEducatorId String
  assessmentType    String
  referralReason    String?
  referralDate      DateTime
  referredBy        String
  conductedBy       String?
  credentials       String?
  clinicName        String?
  assessmentDate    DateTime?
  keyFindings       String?
  diagnosis         String?
  recommendations   String?
  uploadedFiles     String[]
  status            AssessmentStatus       @default(PENDING)
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  specialEducator   SpecialEducatorProfile @relation(fields: [specialEducatorId], references: [id])
  student           Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("formal_assessments")
}

model ReadingSkillAssessment {
  id                                  String                 @id @default(cuid())
  studentId                           String
  specialEducatorId                   String
  missesLetters                       Boolean                @default(false)
  missesWords                         Boolean                @default(false)
  missesSentences                     Boolean                @default(false)
  substitution                        Boolean                @default(false)
  omissionBeginning                   Boolean                @default(false)
  omissionEnding                      Boolean                @default(false)
  omissionWholeWord                   Boolean                @default(false)
  additionWordsOrSyllables            Boolean                @default(false)
  guessingWords                       Boolean                @default(false)
  mispronunciation                    Boolean                @default(false)
  troubleBlendingSyllables            Boolean                @default(false)
  difficultyDecodingUnfamiliar        Boolean                @default(false)
  poorWordRecognition                 Boolean                @default(false)
  troubleRememberingSightWords        Boolean                @default(false)
  troubleLearningLetterSound          Boolean                @default(false)
  shortLongVowelConfusion             Boolean                @default(false)
  poorSyllabication                   Boolean                @default(false)
  poorFlowWhileReading                Boolean                @default(false)
  choppyReading                       Boolean                @default(false)
  lotsOfGaps                          Boolean                @default(false)
  wordByWordReading                   Boolean                @default(false)
  reReadingSameLine                   Boolean                @default(false)
  repetitionOfWords                   Boolean                @default(false)
  vocalizeDuringSilentReading         Boolean                @default(false)
  poorIntonations                     Boolean                @default(false)
  poorPhrasing                        Boolean                @default(false)
  slowEffortfulReading                Boolean                @default(false)
  movesHeadWhileReading               Boolean                @default(false)
  losesPlaceWhileReading              Boolean                @default(false)
  skipsLines                          Boolean                @default(false)
  poorEyeTracking                     Boolean                @default(false)
  poorScanningSkills                  Boolean                @default(false)
  holdsBookTooClose                   Boolean                @default(false)
  difficultyLeftRightEyeMovement      Boolean                @default(false)
  difficultyRecognizingSimilarLetters Boolean                @default(false)
  readsWithoutUnderstanding           Boolean                @default(false)
  forgetsWhatWasRead                  Boolean                @default(false)
  difficultyAnsweringQuestions        Boolean                @default(false)
  notInterestedInReading              Boolean                @default(false)
  avoidsReadingAloud                  Boolean                @default(false)
  avoidsReadingActivities             Boolean                @default(false)
  yawningFrequently                   Boolean                @default(false)
  easilyFrustrated                    Boolean                @default(false)
  lowConfidence                       Boolean                @default(false)
  poorReadingStamina                  Boolean                @default(false)
  punctuationErrors                   Boolean                @default(false)
  doesNotPauseAtFullStop              Boolean                @default(false)
  extraPausesAtCommas                 Boolean                @default(false)
  incorrectToneForQuestionExclamation Boolean                @default(false)
  additionalNotes                     String?
  status                              AssessmentStatus       @default(PENDING)
  completedAt                         DateTime?
  createdAt                           DateTime               @default(now())
  updatedAt                           DateTime               @updatedAt
  readingQ1                           String?
  readingQ2                           String?
  readingQ3                           String?
  specialEducator                     SpecialEducatorProfile @relation(fields: [specialEducatorId], references: [id])
  student                             Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("reading_skill_assessments")
}

model WritingSkillAssessment {
  id                                 String                 @id @default(cuid())
  studentId                          String
  specialEducatorId                  String
  incorrectPencilGrip                Boolean                @default(false)
  holdsPencilTooTightly              Boolean                @default(false)
  holdsPencilTooLoosely              Boolean                @default(false)
  writesExcessivePressure            Boolean                @default(false)
  writesLightPressure                Boolean                @default(false)
  wristFingerPainComplaints          Boolean                @default(false)
  slowFineMotorSpeed                 Boolean                @default(false)
  fatigueAfterShortWriting           Boolean                @default(false)
  incorrectLetterFormation           Boolean                @default(false)
  reversals                          Boolean                @default(false)
  difficultiesFormingCurvesDiagonals Boolean                @default(false)
  lettersWrittenMirrorImage          Boolean                @default(false)
  poorStrokeSequence                 Boolean                @default(false)
  capitalsInsertedBetweenWords       Boolean                @default(false)
  difficultyCopyingLetters           Boolean                @default(false)
  poorSpacingBetweenLetters          Boolean                @default(false)
  poorSpacingBetweenWords            Boolean                @default(false)
  writesOutsideLine                  Boolean                @default(false)
  difficultyMaintainingBaseline      Boolean                @default(false)
  unevenLetterSize                   Boolean                @default(false)
  inconsistentSpacingAcrossPage      Boolean                @default(false)
  crowdedWriting                     Boolean                @default(false)
  tooMuchSpaceBetweenLetters         Boolean                @default(false)
  floatingLettersAboveLine           Boolean                @default(false)
  verySlowWriting                    Boolean                @default(false)
  writesTooFastManyErrors            Boolean                @default(false)
  poorHandwritingEndurance           Boolean                @default(false)
  choppyWriting                      Boolean                @default(false)
  inconsistentPace                   Boolean                @default(false)
  repeatedErasing                    Boolean                @default(false)
  frequentCorrections                Boolean                @default(false)
  difficultyWritingDictatedLetters   Boolean                @default(false)
  difficultyWritingDictatedWords     Boolean                @default(false)
  spellsPhonetically                 Boolean                @default(false)
  omitsLettersInSpelling             Boolean                @default(false)
  addsExtraLetters                   Boolean                @default(false)
  substitutesLettersOrSounds         Boolean                @default(false)
  confusesVowelSounds                Boolean                @default(false)
  troubleEncodingCVC                 Boolean                @default(false)
  troubleEncodingBlendsDigraphs      Boolean                @default(false)
  cannotConstructSimpleSentences     Boolean                @default(false)
  writesOnlySingleWords              Boolean                @default(false)
  strugglesExpandSentences           Boolean                @default(false)
  poorGrammarUsage                   Boolean                @default(false)
  writesIncompleteSentences          Boolean                @default(false)
  confusingSentenceOrder             Boolean                @default(false)
  difficultyExpressingIdeas          Boolean                @default(false)
  avoidsWrittenTasks                 Boolean                @default(false)
  needsVerbalPromptsToWrite          Boolean                @default(false)
  difficultyCopyingFromBoard         Boolean                @default(false)
  difficultyCopyingFromBook          Boolean                @default(false)
  slowCopying                        Boolean                @default(false)
  skipsWordsOrLettersWhenCopying     Boolean                @default(false)
  copiesInaccurately                 Boolean                @default(false)
  looksAwayFrequentlyWhileCopying    Boolean                @default(false)
  writingDisorganized                Boolean                @default(false)
  thoughtsNotLogicallySequenced      Boolean                @default(false)
  cannotPlanWriting                  Boolean                @default(false)
  beginsWritingRandomAreasOnPage     Boolean                @default(false)
  noConceptOfMargins                 Boolean                @default(false)
  paragraphingDifficulty             Boolean                @default(false)
  avoidsWritingActivities            Boolean                @default(false)
  complainsWritingIsHard             Boolean                @default(false)
  getsFrustratedQuickly              Boolean                @default(false)
  lowWritingStamina                  Boolean                @default(false)
  givesUpInMiddleOfTask              Boolean                @default(false)
  lowConfidenceWriting               Boolean                @default(false)
  inconsistentPerformanceAcrossDays  Boolean                @default(false)
  additionalNotes                    String?
  status                             AssessmentStatus       @default(PENDING)
  completedAt                        DateTime?
  createdAt                          DateTime               @default(now())
  updatedAt                          DateTime               @updatedAt
  writingQ1                          String?
  writingQ2                          String?
  writingQ3                          String?
  specialEducator                    SpecialEducatorProfile @relation(fields: [specialEducatorId], references: [id])
  student                            Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("writing_skill_assessments")
}

model MathSkillAssessment {
  id                                  String                 @id @default(cuid())
  studentId                           String
  specialEducatorId                   String
  difficultyIdentifyingNumbers1to10   Boolean                @default(false)
  difficultyIdentifyingNumbers1to20   Boolean                @default(false)
  difficultyIdentifyingNumbers1to100  Boolean                @default(false)
  reversesNumbers                     Boolean                @default(false)
  writesNumbersIncorrectly            Boolean                @default(false)
  difficultySequencingNumbers         Boolean                @default(false)
  skipsNumbersWhileCounting           Boolean                @default(false)
  countsSlowlyOrWithEffort            Boolean                @default(false)
  troubleWithForwardCounting          Boolean                @default(false)
  troubleWithBackwardCounting         Boolean                @default(false)
  difficultyWithSkipCounting          Boolean                @default(false)
  doesNotUnderstandQuantity           Boolean                @default(false)
  cannotMatchNumberToQuantity         Boolean                @default(false)
  cannotCompareNumbers                Boolean                @default(false)
  difficultyIdentifyingPlaceValue     Boolean                @default(false)
  strugglesSingleDigitAddition        Boolean                @default(false)
  strugglesSingleDigitSubtraction     Boolean                @default(false)
  cannotCarryOver                     Boolean                @default(false)
  cannotBorrow                        Boolean                @default(false)
  usesFingerCountingExcessively       Boolean                @default(false)
  cannotPerformMentalMath             Boolean                @default(false)
  doesNotUnderstandPlusMinusSymbols   Boolean                @default(false)
  confusesAdditionSubtraction         Boolean                @default(false)
  difficultyWithWordProblems          Boolean                @default(false)
  cannotUnderstandRealWorldMath       Boolean                @default(false)
  difficultyUnderstandingPatterns     Boolean                @default(false)
  difficultyFinishingPatterns         Boolean                @default(false)
  troubleIdentifyingShapes            Boolean                @default(false)
  troubleSortingObjects               Boolean                @default(false)
  difficultyInMatching                Boolean                @default(false)
  difficultyWithSpatialConcepts       Boolean                @default(false)
  difficultyUnderstandingMeasurement  Boolean                @default(false)
  difficultyWithTimeConcepts          Boolean                @default(false)
  difficultyReadingClock              Boolean                @default(false)
  verySlowInSolvingProblems           Boolean                @default(false)
  frequentCalculationMistakes         Boolean                @default(false)
  poorWorkingMemoryForMath            Boolean                @default(false)
  troubleRememberingMathFacts         Boolean                @default(false)
  difficultyRememberingSteps          Boolean                @default(false)
  needsRepeatedInstructions           Boolean                @default(false)
  getsConfusedDuringMultiStep         Boolean                @default(false)
  misalignsNumbersInColumns           Boolean                @default(false)
  writesNumbersOutsideGrid            Boolean                @default(false)
  poorSpatialOrganization             Boolean                @default(false)
  placesDigitsInWrongOrder            Boolean                @default(false)
  drawsShapesIncorrectly              Boolean                @default(false)
  cannotVisuallyGroupObjects          Boolean                @default(false)
  difficultyCopyingMathFromBoard      Boolean                @default(false)
  confusesMathSymbols                 Boolean                @default(false)
  cannotUnderstandEqualsMeansSameAs   Boolean                @default(false)
  treatsEqualsAsAnswerComesAfter      Boolean                @default(false)
  difficultyRememberingOperationRules Boolean                @default(false)
  cannotDifferentiateTensOnes         Boolean                @default(false)
