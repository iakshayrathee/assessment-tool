generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                       @id @default(cuid())
  email                       String                       @unique
  password                    String
  role                        UserRole
  isActive                    Boolean                      @default(true)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  lastLogin                   DateTime?
  adminProfile                AdminProfile?
  auditLogs                   AuditLog[]
  centerProfile               CenterProfile?
  parentProfile               ParentProfile?
  schoolViewerProfile         SchoolViewerProfile?
  specialEducatorProfile      SpecialEducatorProfile?
  superSpecialEducatorProfile SuperSpecialEducatorProfile?
  notifications               Notification[]

  @@map("users")
}

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model SuperSpecialEducatorProfile {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  fullName                 String
  phone                    String?
  dateOfBirth              DateTime?
  gender                   Gender?
  address                  String?
  primaryLanguage          String?
  secondaryLanguages       String[]
  highestQualification     String?
  fieldOfStudy             String?
  institutionName          String?
  yearOfGraduation         Int?
  rciCertified             Boolean            @default(false)
  rciValidityDate          DateTime?
  specialEdQualification   String?
  specializationAreas      String[]
  yearsOfExperience        Int?
  experienceTypes          String[]
  maxGroupSize             Int?
  currentWorkLocations     String[]
  ldTypesHandled           String[]
  gradeLevelsServed        String[]
  assessmentTools          String?
  assistiveTechProficiency String[]
  areasOfInterest          String[]
  consentToShare           Boolean            @default(false)
  agreementToPolicies      Boolean            @default(false)
  personalStatement        String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  assignedCenters          CenterAssignment[]
  assignedSchools          SchoolAssignment[]
  reviewedReports          Report[]
  trainingLogs             TrainingLog[]
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("super_special_educator_profiles")
}

model SpecialEducatorProfile {
  id                       String              @id @default(cuid())
  userId                   String              @unique
  fullName                 String
  phone                    String?
  dateOfBirth              DateTime?
  gender                   Gender?
  address                  String?
  primaryLanguage          String?
  secondaryLanguages       String[]
  highestQualification     String?
  fieldOfStudy             String?
  institutionName          String?
  yearOfGraduation         Int?
  rciCertified             Boolean             @default(false)
  rciValidityDate          DateTime?
  specialEdQualification   String?
  specializationAreas      String[]
  yearsOfExperience        Int?
  experienceTypes          String[]
  maxGroupSize             Int?
  currentWorkLocations     String[]
  ldTypesHandled           String[]
  gradeLevelsServed        String[]
  assessmentTools          String?
  assistiveTechProficiency String[]
  areasOfInterest          String[]
  consentToShare           Boolean             @default(false)
  agreementToPolicies      Boolean             @default(false)
  personalStatement        String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  additionalCertifications String[]
  totalYearsOfExperience   Int?
  assessments              Assessment[]
  centerAssignments        CenterAssignment[]
  schoolAssignments        SchoolAssignment[]
  iepGoals                 IEPGoal[]
  intakeForms              IntakeForm[]
  reports                  Report[]
  sessionNotes             SessionNote[]
  trainingLogs             TrainingLog[]
  user                     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedStudents         StudentAssignment[]

  @@map("special_educator_profiles")
}

model CenterProfile {
  id             String             @id @default(cuid())
  userId         String             @unique
  centerName     String
  address        String?
  phone          String?
  email          String?
  contactPerson  String?
  operatingHours String?
  description    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  assignments    CenterAssignment[]
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  schools        School[]
  students       Student[]

  @@map("center_profiles")
}

model ParentProfile {
  id               String           @id @default(cuid())
  userId           String           @unique
  fullName         String
  phone            String?
  address          String?
  emergencyContact String?
  relationship     String           @default("Parent")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  concerns         ParentConcern[]
  documents        ParentDocument[]
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  children         Student[]

  @@map("parent_profiles")
}

model SchoolViewerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  position  String?
  phone     String?
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("school_viewer_profiles")
}

model School {
  id            String                @id @default(cuid())
  name          String
  address       String?
  phone         String?
  email         String?
  principalName String?
  centerId      String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  viewers       SchoolViewerProfile[]
  center        CenterProfile         @relation(fields: [centerId], references: [id])
  students      Student[]
  assignments   SchoolAssignment[]

  @@map("schools")
}

model Student {
  id               String              @id @default(cuid())
  fullName         String
  dateOfBirth      DateTime
  age              Int
  gender           Gender
  grade            String
  motherTongue     String?
  syllabus         String?
  status           StudentStatus       @default(ACTIVE)
  registrationDate DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  centerId         String
  schoolId         String?
  parentId         String?
  assessments      Assessment[]
  iepGoals         IEPGoal[]
  intakeForms      IntakeForm[]
  reports          Report[]
  sessionNotes     SessionNote[]
  assignments      StudentAssignment[]
  documents        StudentDocument[]
  center           CenterProfile       @relation(fields: [centerId], references: [id])
  parent           ParentProfile?      @relation(fields: [parentId], references: [id])
  school           School?             @relation(fields: [schoolId], references: [id])

  @@map("students")
}

model StudentAssignment {
  id                String                 @id @default(cuid())
  studentId         String
  specialEducatorId String
  assignedDate      DateTime               @default(now())
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  specialEducator   SpecialEducatorProfile @relation(fields: [specialEducatorId], references: [id])
  student           Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, specialEducatorId])
  @@map("student_assignments")
}

model CenterAssignment {
  id                     String                       @id @default(cuid())
  centerId               String
  specialEducatorId      String?
  superSpecialEducatorId String?
  assignedDate           DateTime                     @default(now())
  isActive               Boolean                      @default(true)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  center                 CenterProfile                @relation(fields: [centerId], references: [id])
  specialEducator        SpecialEducatorProfile?      @relation(fields: [specialEducatorId], references: [id])
  superSpecialEducator   SuperSpecialEducatorProfile? @relation(fields: [superSpecialEducatorId], references: [id])

  @@map("center_assignments")
}

model SchoolAssignment {
  id                     String                       @id @default(cuid())
  schoolId               String
  specialEducatorId      String?
  superSpecialEducatorId String?
  assignedDate           DateTime                     @default(now())
  isActive               Boolean                      @default(true)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  school                 School                       @relation(fields: [schoolId], references: [id])
  specialEducator        SpecialEducatorProfile?      @relation(fields: [specialEducatorId], references: [id])
  superSpecialEducator   SuperSpecialEducatorProfile? @relation(fields: [superSpecialEducatorId], references: [id])

  @@map("school_assignments")
}

model IntakeForm {
  id                                String                 @id @default(cuid())
  studentId                         String
  specialEducatorId                 String
  address                           String?
  familyIncome                      String?
  familyType                        String?
  digitalResourcesAtHome            Boolean?
  dailyDigitalUse                   Int?
  enjoysSchool                      Boolean?
  studyAssistant                    String?
  externalAcademicSupport           Boolean?
  enjoysReading                     Boolean?
  dailyParentChildTime              Int?
  childType                         String?
  fatherName                        String?
  motherName                        String?
  guardianName                      String?
  pregnancyNormal                   Boolean?
  medicationsDuringPregnancy        String?
  miscarriagesAbortions             Boolean?
  fullTermOrPremature               String?
  deliveryType                      String?
  breastFed                         Boolean?
  infantJaundice                    Boolean?
  incubation                        Boolean?
  immunizationDone                  Boolean?
  consanguineousMarriage            Boolean?
  birthCry                          String?
  delayInNeckStanding               Boolean?
  delayInNeckStandingDetails        String?
  ageOfWalking                      Int?
  ageOfTwoWordSpeech                Int?
  healthConcerns                    String?
  epilepticHistory                  Boolean?
  onMedication                      Boolean?
  medicationDetails                 String?
  asthmaWheezing                    Boolean?
  wearsGlasses                      Boolean?
  visionTestDone                    Boolean?
  hearingTestDone                   Boolean?
  attendedPreschool                 Boolean?
  repeatedGrades                    Boolean?
  whichGradeRepeated                String?
  dominantWritingHand               String?
  strugglesInLanguages              Boolean?
  status                            AssessmentStatus       @default(PENDING)
  completedAt                       DateTime?
  createdAt                         DateTime               @default(now())
  updatedAt                         DateTime               @updatedAt
  medicationsDuringPregnancyDetails String?
  specialEducator                   SpecialEducatorProfile @relation(fields: [specialEducatorId], references: [id])
  student                           Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("intake_forms")
}

model Assessment {
  id                    String                 @id @default(cuid())
  studentId             String
  specialEducatorId     String
  readingObservations   String?
  readingLevel          String?
  readingFiles          String[]
  writingObservations   String?
  writingLevel          String?
  writingFiles          String[]
  mathObservations      String?
  mathLevel             String?
  mathFiles             String[]
  vpObservations        String?
  vpLevel               String?
  vpFiles               String[]
  motorObservations     String?
  motorLevel            String?
  motorFiles            String[]
  attentionObservations String?
  attentionLevel        String?
  attentionFiles        String[]
  assessmentType        String                 @default("Initial")
  status                AssessmentStatus       @default(PENDING)
  completedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  specialEducator       SpecialEducatorProfile @relation(fields: [specialEducatorId], references: [id])
  student               Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("assessments")
}

model IEPGoal {
  id                String                 @id @default(cuid())
  studentId         String
  specialEducatorId String
  domain            String
  goalStatement     String
  strategy          String?
  startDate         DateTime
  targetDate        DateTime
  expectedOutcome   String?
  progressPercent   Int                    @default(0)
  status            IEPGoalStatus          @default(NOT_STARTED)
  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  specialEducator   SpecialEducatorProfile @relation(fields: [specialEducatorId], references: [id])
  student           Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  progressUpdates   IEPProgress[]

  @@map("iep_goals")
}

model IEPProgress {
  id         String   @id @default(cuid())
  goalId     String
  updateDate DateTime @default(now())
  progress   Int
  notes      String?
  rating     String?
  createdAt  DateTime @default(now())
  goal       IEPGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("iep_progress")
}

model SessionNote {
  id                String                 @id @default(cuid())
  studentId         String
  specialEducatorId String
  sessionDate       DateTime
  duration          Int?
  activities        String
  observations      String?
  progress          String?
  nextSteps         String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  specialEducator   SpecialEducatorProfile @relation(fields: [specialEducatorId], references: [id])
  student           Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("session_notes")
}

model Report {
  id                     String                       @id @default(cuid())
  studentId              String
  specialEducatorId      String
  superSpecialEducatorId String?
  type                   ReportType
  title                  String
  content                String
  summary                String?
  recommendations        String?
  educatorSignature      String?
  status                 AssessmentStatus             @default(PENDING)
  submittedAt            DateTime?
  reviewedAt             DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  specialEducator        SpecialEducatorProfile       @relation(fields: [specialEducatorId], references: [id])
  student                Student                      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  superSpecialEducator   SuperSpecialEducatorProfile? @relation(fields: [superSpecialEducatorId], references: [id])

  @@map("reports")
}

model ParentConcern {
  id          String        @id @default(cuid())
  parentId    String
  studentId   String?
  title       String
  description String
  category    String?
  priority    String        @default("Medium")
  status      String        @default("Open")
  response    String?
  respondedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  parent      ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@map("parent_concerns")
}

model StudentDocument {
  id          String   @id @default(cuid())
  studentId   String
  fileName    String
  filePath    String
  fileType    String
  fileSize    Int
  category    String?
  description String?
  uploadedBy  String
  createdAt   DateTime @default(now())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_documents")
}

model ParentDocument {
  id          String        @id @default(cuid())
  parentId    String
  fileName    String
  filePath    String
  fileType    String
  fileSize    Int
  category    String?
  description String?
  createdAt   DateTime      @default(now())
  parent      ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@map("parent_documents")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      String?  // JSON data for additional context
  createdAt DateTime @default(now())
  readAt    DateTime?
  user      User     @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model TrainingLog {
  id                     String                       @id @default(cuid())
  superSpecialEducatorId String
  specialEducatorId      String?
  title                  String
  description            String
  type                   TrainingType                 @default(MENTORSHIP)
  duration               Int?                         // Duration in minutes
  participants           String[]                     // Array of educator IDs
  notes                  String?
  followUpRequired       Boolean                      @default(false)
  followUpDate           DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  superSpecialEducator   SuperSpecialEducatorProfile  @relation(fields: [superSpecialEducatorId], references: [id])
  specialEducator        SpecialEducatorProfile?      @relation(fields: [specialEducatorId], references: [id])

  @@map("training_logs")
}

enum UserRole {
  ADMIN
  SUPER_SPECIAL_EDUCATOR
  SPECIAL_EDUCATOR
  CENTER
  PARENT
  SCHOOL_VIEWER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AssessmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REVIEWED
}

enum IEPGoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  DISCONTINUED
}

enum ReportType {
  INTAKE
  ASSESSMENT
  IEP
  PROGRESS
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
}

enum TrainingType {
  MENTORSHIP
  WORKSHOP
  OBSERVATION
  FEEDBACK_SESSION
  PROFESSIONAL_DEVELOPMENT
  CASE_CONSULTATION
}
