enum RiskCategory {
  HIGH_SUPPORT
  MODERATE_SUPPORT
  ON_TRACK
}

enum ReportPeriodType {
  MONTHLY
  QUARTERLY
  YEARLY
}

model SchoolReportSnapshot {
  id          String           @id @default(cuid())
  schoolId    String
  periodType  ReportPeriodType
  periodStart DateTime
  periodEnd   DateTime

  // Reach & Coverage
  totalEnrolled  Int
  totalScreened  Int
  totalSupported Int
  gradesCovered  String[]

  // Risk Categories
  highSupportCount         Int
  moderateSupportCount     Int
  onTrackCount             Int
  highSupportReduction     Float?
  moderateSupportReduction Float?
  onTrackIncrease          Float?

  // Skill Area Metrics (% students needing support)
  readingReadinessPercent    Float?
  writingReadinessPercent    Float?
  numeracyReadinessPercent   Float?
  attentionEngagementPercent Float?
  processingMemoryPercent    Float?

  // Impact Metrics
  totalSessions      Int
  averageImprovement Json? // Per domain improvements

  // New Dashboard 1 Metrics - Student Progress Levels
  newStudentsThisMonth       Int?
  studentsImproving          Int?
  studentsStable             Int?
  studentsRequiringAttention Int?

  // New Dashboard 3 Metrics - Time Saved for Teachers (in hours)
  manualObservationTimeSaved      Int?
  lessonPlanningTimeSaved         Int?
  trackingWorkloadTimeSaved       Int?
  differentiationSupportTimeSaved Int?
  totalTimeSaved                  Int?

  // New Dashboard 3 Metrics - Evidence of Interventions
  individualSupportPlansCreated    Int?
  smallGroupInterventions          Int?
  classroomStrategyRecommendations Int?
  reviewCyclesCompleted            Int?

  // AI-Generated Narratives
  executiveSummary  String?
  coverageNarrative String?
  impactNarrative   String?
  recommendations   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, periodType, periodStart])
  @@map("school_report_snapshots")
}

model CenterReportSnapshot {
  id          String           @id @default(cuid())
  centerId    String
  periodType  ReportPeriodType
  periodStart DateTime
  periodEnd   DateTime

  // Student Coverage Statistics
  totalStudentsRegistered   Int
  studentsAssessed          Int
  studentsUnderIntervention Int
  newStudentsThisPeriod     Int
  activeStudents            Int
  exitedMainstreamed        Int

  // Assessment Statistics
  totalAssessmentsConducted Int
  baselineAssessments       Int
  reviewProgressAssessments Int
  averageAssessmentTime     Float?
  assessmentsPerEducator    Float?

  // Intervention Statistics
  individualInterventionPlans Int
  smallGroupInterventions     Int
  totalInterventionSessions   Int
  avgSessionsPerStudent       Float?
  avgDurationPerSession       Float?

  // Progress & Outcome Statistics (by domain)
  readingImprovement           Float?
  writingImprovement           Float?
  mathematicsImprovement       Float?
  attentionBehaviorImprovement Float?

  // Educator Productivity Metrics
  activeSpecialEducators Int
  avgStudentsPerEducator Float?
  avgSessionsPerEducator Float?
  avgReportsGenerated    Float?

  // Compliance & Documentation Statistics (percentages)
  assessmentRecordsAvailable  Float?
  interventionPlansDocumented Float?
  progressReviewsCompleted    Float?
  parentReportsShared         Float?

  // Coverage Information
  schoolsCovered String[]
  gradesCovered  String[]

  // AI-Generated Narratives
  executiveSummary String?
  recommendations  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  center CenterProfile @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId, periodType, periodStart])
  @@map("center_report_snapshots")
}

model ParentReportSnapshot {
  id          String           @id @default(cuid())
  studentId   String
  parentId    String
  periodType  ReportPeriodType
  periodStart DateTime
  periodEnd   DateTime

  // Student Information
  studentName          String
  studentGrade         String
  studentAge           Int
  enrollmentDate       DateTime
  assignedEducatorName String?

  // Assessment Summary
  totalAssessments      Int
  latestAssessmentDate  DateTime?
  latestAssessmentScore Float?
  riskLevel             String? // "High", "Moderate", "On Track"
  assessmentProgress    String? // Brief summary

  // Progress Tracking
  readingProgress       Float? // Percentage improvement
  writingProgress       Float?
  mathProgress          Float?
  attentionProgress     Float?
  overallGoalCompletion Float? // Percentage of goals completed

  // Attendance & Session Participation
  totalSessionsScheduled Int
  sessionsAttended       Int
  participationRate      Float? // Percentage
  lastSessionDate        DateTime?

  // Individual Intervention Plan - Focus Areas
  focusReading     Boolean @default(false)
  focusWriting     Boolean @default(false)
  focusMathematics Boolean @default(false)
  focusAttention   Boolean @default(false)
  focusConfidence  Boolean @default(false)

  // Intervention Goals
  shortTermGoals String? // JSON array or text
  longTermGoals  String? // JSON array or text

  // Intervention Strategies (per area)
  readingStrategy     String?
  writingStrategy     String?
  mathematicsStrategy String?
  attentionStrategy   String?
  confidenceStrategy  String?

  // Additional Information
  educatorNotes         String?
  parentFriendlySummary String? // AI-generated or educator-written
  nextReviewDate        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([studentId, periodType, periodStart])
  @@index([parentId, periodStart])
  @@map("parent_report_snapshots")
}
