  unknownTextFluency   String?   // Fast / On-level / Slow / Very slow
  unknownTextErrors    String?   // Minimal / Moderate / Frequent
  unknownTextObservation String? // Observation details
  
  // Resource Context Assessment
  materialTypes        String[]  // Storybooks, School textbooks, Worksheets, Digital content, Knowledge Material
  materialLevels       String[]  // Reading level for each material type
  readingIndependence  String?   // Reads independently / Needs support / Avoids reading

  // ── LEGACY COMPATIBILITY ───────────────────────────────────────────────────
