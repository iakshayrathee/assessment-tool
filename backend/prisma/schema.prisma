  description               String?
  suggestedGrade            String?
  suggestedDomains          String[]
  totalQuestions            Int?
  totalMaxScore             Int?
  timesUsed                 Int                    @default(0)
  lastUsedAt                DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime
  mass_assessments          MassAssessment[]
  special_educator_profiles SpecialEducatorProfile @relation(fields: [educatorId], references: [id])

  @@index([educatorId])
  @@index([extractionStatus])
  @@map("worksheet_templates")
}

