# Database
DATABASE_URL="postgresql://username:password@localhost:5432/knowled_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH="./uploads"

# CORS
FRONTEND_URL="http://localhost:3000"
